# You can leave this file alone: the app asks for these keys in your browser the first time you open it.
# If you prefer to fill it in by hand: copy this file to ".env" and paste each value after the "=".

# PayPal Client ID: developer.paypal.com > Apps & Credentials > (Sandbox) > your app > Client ID
PAYPAL_CLIENT_ID=
# PayPal Secret: same page, click "Show" under Secret
PAYPAL_CLIENT_SECRET=
# Claude key: console.anthropic.com > API Keys > Create Key
ANTHROPIC_API_KEY=

# Optional. PayPal's practice (sandbox) system is the default. Only change this to go live (see README).
# PAYPAL_BASE=https://api-m.sandbox.paypal.com
