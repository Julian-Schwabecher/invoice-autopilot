# You can leave this file alone: the app asks for these keys in your browser the first time you open it.
# If you prefer to fill it in by hand: copy this file to ".env" and paste each value after the "=".

# PayPal Client ID: developer.paypal.com > Apps & Credentials > (Sandbox) > your app > Client ID
PAYPAL_CLIENT_ID=
# PayPal Secret: same page, click "Show" under Secret
PAYPAL_CLIENT_SECRET=
# Claude key: console.anthropic.com > API Keys > Create Key
ANTHROPIC_API_KEY=

# Optional. PayPal's practice (sandbox) system is the default. Only change this to go live (see README).
# PAYPAL_BASE=https://api-m.sandbox.paypal.com

# Optional. Live status: lets PayPal tell the app when an invoice is paid. In developer.paypal.com open your
# app, add a webhook pointing at https://<your public address>/api/webhooks/paypal with the event types
# "INVOICING.INVOICE.*" (Invoice paid, Invoice updated and so on), then paste its Webhook ID here.
# Until this is set the webhook address answers "Webhooks aren't set up" and the app ignores everything sent to it.
# PAYPAL_WEBHOOK_ID=

# Optional. Safe mode (1 = on): invoices and reminders are NOT sent; the app shows exactly what it would have
# sent instead. You can also switch it on and off in the app.
# SAFE_MODE=0
